// Plataforma multiagente — vocabulario agente (no PRIA / no runs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// WORKSPACE & USERS
// ============================================

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  agentConfigs  AgentConfig[]
  missions      Mission[]
  pieces        ContentPiece[]
  clusters      ContentCluster[]
  approvals     Approval[]
  publications  Publication[]
  activities    AgentActivity[]
  integrations  Integration[]
  metrics       MetricSnapshot[]
  opportunities KeywordOpportunity[]
  questions     KeywordQuestion[]
  founderNotes  FounderVoiceNote[]
  founderInvites FounderVoiceInvite[]
  ctaEvents     CtaEvent[]
  creativeRequests  CreativeRequest[]
  creativeAssets    CreativeAsset[]
  distributionPosts DistributionPost[]
  creativePerformances CreativePerformance[]
  agentJobs         AgentJob[]
  growthConversationRuns GrowthConversationRun[]
  growthSearchQueries    GrowthSearchQuery[]
  growthSerpHits         GrowthSerpHit[]
  growthConversationPages GrowthConversationPage[]
  growthOpportunities    GrowthOpportunity[]
  growthReplyDrafts      GrowthReplyDraft[]
  growthInterventions    GrowthIntervention[]
  growthInterventionMetrics GrowthInterventionMetric[]
  growthTopicInsights    GrowthTopicInsight[]

  @@map("workspaces")
}

enum UserRole {
  admin
  editor
  viewer
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         UserRole @default(editor)
  workspaceId  String   @map("workspace_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  approvals Approval[] @relation("ReviewedBy")
  growthReplyApprovals GrowthReplyDraft[] @relation("GrowthReplyApprovedBy")
  growthInterventions  GrowthIntervention[] @relation("GrowthInterventionRegisteredBy")

  @@index([workspaceId])
  @@map("users")
}

// ============================================
// AGENTS
// ============================================

model Agent {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  configs    AgentConfig[]
  missions   Mission[]
  activities AgentActivity[]

  @@map("agents")
}

model AgentConfig {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  agentId     String   @map("agent_id")
  tone        String?  @db.Text
  topics      Json?    // temas prioritarios / seeds Discovery
  frequency   String?  // ej: "2/semana"
  autoPublish Boolean  @default(false) @map("auto_publish")
  branding    Json?    // brand kit: colores, CTA, logo, templateId
  /// Perfil del agente (ej. Discovery: siteUrl, description, market, language)
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  agent     Agent     @relation(fields: [agentId], references: [id])

  @@unique([workspaceId, agentId])
  @@map("agent_configs")
}

// ============================================
// MISSIONS (no "runs")
// ============================================

enum MissionStatus {
  pending
  in_progress
  completed
  failed
  cancelled
}

enum MissionTrigger {
  manual
  scheduled
  refresh_scan
}

model Mission {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  agentId     String         @map("agent_id")
  title       String
  objective   String?        @db.Text
  status      MissionStatus  @default(pending)
  trigger     MissionTrigger @default(manual)
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id])
  agent      Agent         @relation(fields: [agentId], references: [id])
  steps      MissionStep[]
  pieces     ContentPiece[]
  activities AgentActivity[]

  @@index([workspaceId, status])
  @@index([agentId])
  @@map("missions")
}

enum MissionStepRole {
  strategist
  researcher
  journalist
  writer
  seo_builder
  publisher
  refresher
  contactor
}

enum MissionStepStatus {
  pending
  in_progress
  completed
  failed
  skipped
}

model MissionStep {
  id        String            @id @default(uuid())
  missionId String            @map("mission_id")
  role      MissionStepRole
  status    MissionStepStatus @default(pending)
  input     Json?
  output    Json?
  message   String?           @db.Text
  startedAt DateTime?         @map("started_at")
  endedAt   DateTime?         @map("ended_at")
  createdAt DateTime          @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("mission_steps")
}

// ============================================
// CONTENT
// ============================================

enum ContentPieceType {
  faq
  definition
  glossary
  checklist
  comparison
  how_to
  pillar
  case_study
  calculator
  landing
  other
}

enum ContentPieceStatus {
  idea
  draft
  pending_approval
  approved
  published
  refresh_needed
  archived
}

model ContentCluster {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  pillarTopic String?  @map("pillar_topic") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  pieces    ContentPiece[]

  @@index([workspaceId])
  @@map("content_clusters")
}

model ContentPiece {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  missionId   String?            @map("mission_id")
  clusterId   String?            @map("cluster_id")
  type        ContentPieceType
  title       String
  slug        String?
  keyword     String?
  status      ContentPieceStatus @default(idea)
  content     Json?              // HTML/MD + metadata SEO
  seoMeta     Json?              @map("seo_meta")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  mission     Mission?        @relation(fields: [missionId], references: [id])
  cluster     ContentCluster? @relation(fields: [clusterId], references: [id])
  approval    Approval?
  publication Publication?
  creativeRequests CreativeRequest[]
  growthConversationRuns GrowthConversationRun[]
  growthSearchQueries    GrowthSearchQuery[]
  growthOpportunities    GrowthOpportunity[]
  growthTopicInsights    GrowthTopicInsight[]

  @@index([workspaceId, status])
  @@index([missionId])
  @@map("content_pieces")
}

// ============================================
// APPROVALS & PUBLICATIONS
// ============================================

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested
}

model Approval {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  pieceId      String         @unique @map("piece_id")
  status       ApprovalStatus @default(pending)
  notes        String?        @db.Text
  reviewedById String?        @map("reviewed_by_id")
  reviewedAt   DateTime?      @map("reviewed_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  workspace  Workspace    @relation(fields: [workspaceId], references: [id])
  piece      ContentPiece @relation(fields: [pieceId], references: [id])
  reviewedBy User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([workspaceId, status])
  @@map("approvals")
}

model Publication {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  pieceId       String    @unique @map("piece_id")
  externalId    String?   @map("external_id") // WP post ID
  url           String?
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  /// Sprint 5.2 — última solicitud a Google Indexing API
  gscSubmittedAt   DateTime? @map("gsc_submitted_at")
  gscSubmitStatus  String?   @map("gsc_submit_status") // ok | error | skipped
  gscSubmitDetail  String?   @map("gsc_submit_detail") @db.Text

  /// Sprint 5.2 — última notificación IndexNow (Bing+)
  indexNowSubmittedAt DateTime? @map("indexnow_submitted_at")
  indexNowStatus      String?   @map("indexnow_status") // ok | error | skipped
  indexNowDetail      String?   @map("indexnow_detail") @db.Text

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  piece     ContentPiece @relation(fields: [pieceId], references: [id])
  creativeRequests CreativeRequest[]
  growthConversationRuns GrowthConversationRun[]

  @@index([workspaceId])
  @@map("publications")
}

// ============================================
// AGENT ACTIVITY (feed en tiempo real)
// ============================================

enum ActivityLevel {
  info
  success
  warning
  error
}

model AgentActivity {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  agentId     String        @map("agent_id")
  missionId   String?       @map("mission_id")
  role        MissionStepRole?
  level       ActivityLevel @default(info)
  message     String        @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  agent     Agent     @relation(fields: [agentId], references: [id])
  mission   Mission?  @relation(fields: [missionId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([agentId])
  @@map("agent_activities")
}

// ============================================
// INTEGRATIONS & METRICS
// ============================================

enum IntegrationType {
  wordpress
  google_analytics
  google_search_console
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

model Integration {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  type        IntegrationType
  status      IntegrationStatus @default(disconnected)
  config      Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, type])
  @@map("integrations")
}

model MetricSnapshot {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  url         String
  impressions Int?
  clicks      Int?
  ctr         Float?
  sessions    Int?
  source      String   // "gsc" | "ga4"
  capturedAt  DateTime @map("captured_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, url, capturedAt])
  @@map("metric_snapshots")
}

// ============================================
// KEYWORD OPPORTUNITIES (Input engine — Fase A)
// ============================================

enum FunnelStage {
  tofu
  mofu
  bofu
}

enum KeywordOpportunityStatus {
  idea
  queued
  in_progress
  covered
  discarded
}

model KeywordOpportunity {
  id                String                    @id @default(uuid())
  workspaceId       String                    @map("workspace_id")
  seedKeyword       String                    @map("seed_keyword")
  keyword           String
  cluster           String
  stage             FunnelStage
  intent            String?
  intentLabel       String?                   @map("intent_label")
  status            KeywordOpportunityStatus  @default(idea)
  priority          Int                       @default(0)
  source            String                    @default("manual")
  notes             String?                   @db.Text
  gscImpressions    Int?                      @map("gsc_impressions")
  gscClicks         Int?                      @map("gsc_clicks")
  demandScore       Int?                      @map("demand_score")
  scoreReason       String?                   @map("score_reason") @db.Text
  scoredAt          DateTime?                 @map("scored_at")
  /// Volumen mensual (Keyword Planner / DataForSEO)
  monthlySearches   Int?                      @map("monthly_searches")
  trendScore        Int?                      @map("trend_score")
  relevanceScore    Int?                      @map("relevance_score")
  opportunityScore  Int?                      @map("opportunity_score")
  /// Content Opportunity Brief (JSON)
  brief             Json?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, keyword])
  @@index([workspaceId, status])
  @@index([workspaceId, stage])
  @@index([workspaceId, cluster])
  @@index([workspaceId, priority])
  @@index([workspaceId, demandScore])
  @@index([workspaceId, opportunityScore])
  @@map("keyword_opportunities")
}

enum KeywordQuestionStatus {
  idea
  queued
  in_progress
  covered
  discarded
}

/// Preguntas reales por cluster (AnswerThePublic-like) — Sprint 1.3
model KeywordQuestion {
  id           String                @id @default(uuid())
  workspaceId  String                @map("workspace_id")
  cluster      String
  question     String
  stage        FunnelStage           @default(tofu)
  intent       String?
  intentLabel  String?               @map("intent_label")
  businessFit  Int                   @default(50) @map("business_fit")
  priority     Int                   @default(0)
  status       KeywordQuestionStatus @default(idea)
  source       String                @default("llm")
  notes        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, question])
  @@index([workspaceId, status])
  @@index([workspaceId, cluster])
  @@index([workspaceId, priority])
  @@map("keyword_questions")
}

enum FounderVoiceNoteStatus {
  available
  used
  discarded
}

/// Frases del founder/CEO — Sprint 2.2 (no bloquean publicación)
model FounderVoiceNote {
  id            String                  @id @default(uuid())
  workspaceId   String                  @map("workspace_id")
  topic         String?
  quote         String                  @db.Text
  authorLabel   String                  @default("Founder") @map("author_label")
  status        FounderVoiceNoteStatus  @default(available)
  usedInPieceId String?                 @map("used_in_piece_id")
  inviteId      String?                 @map("invite_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id])
  invite    FounderVoiceInvite? @relation(fields: [inviteId], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, topic])
  @@map("founder_voice_notes")
}

model FounderVoiceInvite {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  token       String    @unique
  topic       String?
  missionId   String?   @map("mission_id")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  notes     FounderVoiceNote[]

  @@index([workspaceId, expiresAt])
  @@map("founder_voice_invites")
}

// ============================================
// CTA A/B (Sprint 4.2)
// ============================================

model CtaEvent {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  pieceId     String?  @map("piece_id")
  url         String?
  variant     String   // A | B
  eventType   String   @map("event_type") // click | submit
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, variant, createdAt])
  @@index([workspaceId, url])
  @@map("cta_events")
}

// ============================================
// WHATSAPP (Baileys / BuilderBot bridge)
// ============================================

model WhatsAppMessage {
  id           String   @id @default(uuid())
  chatId       String   @map("chat_id")
  phoneDigits  String?  @map("phone_digits")
  direction    String
  message      String   @db.Text
  mediaUrl     String?  @map("media_url")
  status       String   @default("received")
  source       String?
  externalId   String?  @map("external_id")
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([chatId, createdAt])
  @@index([phoneDigits])
  @@map("whatsapp_messages")
}

// ============================================
// GROWTH — Creative Engine
// ============================================

enum CreativeRequestStatus {
  queued
  planning
  rendering
  preview
  approved
  blocked
  failed
}

enum DistributionChannel {
  linkedin
}

enum DistributionPostStatus {
  draft
  preview
  published
  failed
}

/// Catálogo versionado de templates creativos (no sobrescribir en silencio).
model CreativeTemplate {
  id          String   @id @default(uuid())
  templateKey String   @map("template_key")
  version     Int      @default(1)
  category    String
  name        String
  config      Json
  deprecated  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  assets CreativeAsset[]

  @@unique([templateKey, version])
  @@index([category])
  @@map("creative_templates")
}

model CreativeRequest {
  id              String                @id @default(uuid())
  workspaceId     String                @map("workspace_id")
  pieceId         String                @map("piece_id")
  publicationId   String?               @map("publication_id")
  channel         DistributionChannel   @default(linkedin)
  status          CreativeRequestStatus @default(queued)
  input           Json?
  plannerOutput   Json?                 @map("planner_output")
  errorMessage    String?               @map("error_message") @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  piece       ContentPiece  @relation(fields: [pieceId], references: [id])
  publication Publication?  @relation(fields: [publicationId], references: [id])
  assets      CreativeAsset[]
  posts       DistributionPost[]

  @@index([workspaceId, status, createdAt])
  @@index([pieceId])
  @@map("creative_requests")
}

model CreativeAsset {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  requestId         String   @map("request_id")
  templateId        String   @map("template_id")
  templateKey       String   @map("template_key")
  templateVersion   Int      @map("template_version")
  filePath          String   @map("file_path")
  mimeType          String   @default("image/png") @map("mime_type")
  width             Int
  height            Int
  format            String   // linkedin_square | linkedin_landscape
  payload           Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  request   CreativeRequest   @relation(fields: [requestId], references: [id])
  template  CreativeTemplate  @relation(fields: [templateId], references: [id])
  posts     DistributionPost[]
  performances CreativePerformance[]

  @@index([workspaceId, createdAt])
  @@index([requestId])
  @@index([templateKey, templateVersion])
  @@map("creative_assets")
}

model DistributionPost {
  id             String                 @id @default(uuid())
  workspaceId    String                 @map("workspace_id")
  requestId      String                 @map("request_id")
  assetId        String                 @map("asset_id")
  channel        DistributionChannel    @default(linkedin)
  status         DistributionPostStatus @default(draft)
  externalPostId String?                @map("external_post_id")
  caption        String?                @db.Text
  publishedAt    DateTime?              @map("published_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  request   CreativeRequest @relation(fields: [requestId], references: [id])
  asset     CreativeAsset   @relation(fields: [assetId], references: [id])
  performances CreativePerformance[]

  @@index([workspaceId, channel, status])
  @@index([assetId])
  @@map("distribution_posts")
}

model CreativePerformance {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  assetId     String   @map("asset_id")
  postId      String?  @map("post_id")
  templateKey String   @map("template_key")
  impressions Int?
  clicks      Int?
  reactions   Int?
  comments    Int?
  shares      Int?
  ctr         Float?
  engagements Int?
  collectedAt DateTime @map("collected_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  asset     CreativeAsset     @relation(fields: [assetId], references: [id])
  post      DistributionPost? @relation(fields: [postId], references: [id])

  @@index([workspaceId, templateKey, collectedAt])
  @@index([assetId])
  @@map("creative_performances")
}

// ============================================
// PERSISTENT JOBS (cola recuperable)
// ============================================

enum AgentJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model AgentJob {
  id          String         @id @default(uuid())
  workspaceId String?        @map("workspace_id")
  type        String
  payload     Json
  status      AgentJobStatus @default(pending)
  attempts    Int            @default(0)
  maxAttempts Int            @default(5) @map("max_attempts")
  nextRunAt   DateTime       @default(now()) @map("next_run_at")
  lockedAt    DateTime?      @map("locked_at")
  lockedBy    String?        @map("locked_by")
  lastError   String?        @map("last_error") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  completedAt DateTime?      @map("completed_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([status, nextRunAt])
  @@index([workspaceId, type, status])
  @@map("agent_jobs")
}

// ============================================
// GROWTH — Conversaciones (distribución contextual)
// ============================================

enum GrowthRunStatus {
  queued
  generating_queries
  searching
  verifying
  scoring
  drafting
  completed
  completed_partial
  failed
  cancelled
}

enum GrowthRunTrigger {
  manual
  auto_publish
}

enum GrowthSerpResultType {
  organic
  discussions_and_forums
  questions_and_answers
  other
}

enum GrowthVerifyStatus {
  pending
  verified
  not_verifiable
  excluded
}

/// Estado editorial de la oportunidad (aprobado ≠ publicado).
enum GrowthOpportunityEditorialStatus {
  candidate
  draft_ready
  approved
  discarded
}

enum GrowthReplyDraftStatus {
  pending_review
  approved
  discarded
}

enum GrowthMetricKind {
  ga4_sessions
  contact_manual
  commercial_manual
  interaction_manual
}

enum GrowthMetricSource {
  ga4
  manual
}

enum GrowthTopicInsightStatus {
  draft_for_discovery
  reviewed
  dismissed
}

model GrowthConversationRun {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  pieceId           String           @map("piece_id")
  publicationId     String?          @map("publication_id")
  status            GrowthRunStatus  @default(queued)
  trigger           GrowthRunTrigger @default(manual)
  configSnapshot    Json?            @map("config_snapshot")
  providerMode      String?          @map("provider_mode") // sandbox | live | none
  queryCount        Int              @default(0) @map("query_count")
  serpHitCount      Int              @default(0) @map("serp_hit_count")
  verifiedCount     Int              @default(0) @map("verified_count")
  opportunityCount  Int              @default(0) @map("opportunity_count")
  costUsd           Float?           @map("cost_usd")
  costEstimatedUsd  Float?           @map("cost_estimated_usd")
  costIsEstimate    Boolean          @default(true) @map("cost_is_estimate")
  errorMessage      String?          @map("error_message") @db.Text
  progressMessage   String?          @map("progress_message") @db.Text
  startedAt         DateTime?        @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  cancelledAt       DateTime?        @map("cancelled_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  piece       ContentPiece  @relation(fields: [pieceId], references: [id])
  publication Publication?  @relation(fields: [publicationId], references: [id])
  queries     GrowthSearchQuery[]
  serpHits    GrowthSerpHit[]
  opportunities GrowthOpportunity[]
  topicInsights GrowthTopicInsight[]

  @@index([workspaceId, status, createdAt])
  @@index([pieceId, createdAt])
  @@map("growth_conversation_runs")
}

model GrowthSearchQuery {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  runId           String   @map("run_id")
  pieceId         String   @map("piece_id")
  query           String
  queryNormalized String   @map("query_normalized")
  rationale       String?  @db.Text
  languageCode    String   @map("language_code")
  locationCode    Int      @map("location_code")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  run       GrowthConversationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  piece     ContentPiece         @relation(fields: [pieceId], references: [id])
  serpHits  GrowthSerpHit[]

  @@unique([runId, queryNormalized])
  @@index([workspaceId, pieceId])
  @@map("growth_search_queries")
}

model GrowthSerpHit {
  id              String              @id @default(uuid())
  workspaceId     String              @map("workspace_id")
  runId           String              @map("run_id")
  queryId         String              @map("query_id")
  url             String
  urlNormalized   String              @map("url_normalized")
  title           String?
  snippet         String?             @db.Text
  position        Int?
  resultType      GrowthSerpResultType @default(organic) @map("result_type")
  domain          String?
  providerPayload Json?               @map("provider_payload")
  providerMode    String              @map("provider_mode")
  excludedReason  String?             @map("excluded_reason")
  createdAt       DateTime            @default(now()) @map("created_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id])
  run       GrowthConversationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  query     GrowthSearchQuery     @relation(fields: [queryId], references: [id], onDelete: Cascade)
  opportunities GrowthOpportunity[]

  @@unique([runId, urlNormalized])
  @@index([workspaceId, urlNormalized])
  @@index([runId])
  @@map("growth_serp_hits")
}

model GrowthConversationPage {
  id                     String             @id @default(uuid())
  workspaceId            String             @map("workspace_id")
  url                    String
  urlNormalized          String             @map("url_normalized")
  domain                 String
  title                  String?
  topic                  String?            @db.Text
  questionText           String?            @map("question_text") @db.Text
  audienceFitNotes       String?            @map("audience_fit_notes") @db.Text
  threadCreatedAt        DateTime?          @map("thread_created_at")
  lastActivityAt         DateTime?          @map("last_activity_at")
  threadCreatedAtKnown   Boolean            @default(false) @map("thread_created_at_known")
  lastActivityAtKnown    Boolean            @default(false) @map("last_activity_at_known")
  participationSignals   Json?              @map("participation_signals")
  allowsReplies          Boolean?           @map("allows_replies")
  isClosed               Boolean?           @map("is_closed")
  isArchived             Boolean?           @map("is_archived")
  linkRulesNotes         String?            @map("link_rules_notes") @db.Text
  evidenceSnippet        String?            @map("evidence_snippet") @db.Text
  verifyStatus           GrowthVerifyStatus @default(pending) @map("verify_status")
  verifiedAt             DateTime?          @map("verified_at")
  verifyError            String?            @map("verify_error") @db.Text
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  opportunities GrowthOpportunity[]

  @@unique([workspaceId, urlNormalized])
  @@index([workspaceId, verifyStatus])
  @@map("growth_conversation_pages")
}

model GrowthOpportunity {
  id                  String                          @id @default(uuid())
  workspaceId         String                          @map("workspace_id")
  runId               String                          @map("run_id")
  pieceId             String                          @map("piece_id")
  conversationId      String                          @map("conversation_id")
  serpHitId           String?                         @map("serp_hit_id")
  opportunityScore    Float                           @map("opportunity_score")
  evidenceConfidence  Float                           @map("evidence_confidence")
  scoreBreakdown      Json                            @map("score_breakdown")
  editorialStatus     GrowthOpportunityEditorialStatus @default(candidate) @map("editorial_status")
  discardReason       String?                         @map("discard_reason") @db.Text
  recommendedRank     Int?                            @map("recommended_rank")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")

  workspace    Workspace               @relation(fields: [workspaceId], references: [id])
  run          GrowthConversationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  piece        ContentPiece            @relation(fields: [pieceId], references: [id])
  conversation GrowthConversationPage  @relation(fields: [conversationId], references: [id])
  serpHit      GrowthSerpHit?          @relation(fields: [serpHitId], references: [id])
  drafts       GrowthReplyDraft[]
  interventions GrowthIntervention[]

  @@unique([runId, conversationId])
  @@index([workspaceId, editorialStatus])
  @@index([pieceId])
  @@map("growth_opportunities")
}

model GrowthReplyDraft {
  id            String                 @id @default(uuid())
  workspaceId   String                 @map("workspace_id")
  opportunityId String                 @map("opportunity_id")
  version       Int                    @default(1)
  body          String                 @db.Text
  includeLink   Boolean                @default(false) @map("include_link")
  linkUrl       String?                @map("link_url")
  sources       Json?
  status        GrowthReplyDraftStatus @default(pending_review)
  approvedById  String?                @map("approved_by_id")
  approvedAt    DateTime?              @map("approved_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  opportunity GrowthOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  approvedBy  User?             @relation("GrowthReplyApprovedBy", fields: [approvedById], references: [id])
  interventions GrowthIntervention[]

  @@index([workspaceId, status])
  @@index([opportunityId, version])
  @@map("growth_reply_drafts")
}

model GrowthIntervention {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  opportunityId    String   @map("opportunity_id")
  replyDraftId     String   @map("reply_draft_id")
  attributionId    String   @unique @map("attribution_id")
  publishedUrl     String   @map("published_url")
  publishedAt      DateTime @map("published_at")
  registeredById   String   @map("registered_by_id")
  registeredAt     DateTime @default(now()) @map("registered_at")
  articleUrlWithUtm String? @map("article_url_with_utm")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  opportunity GrowthOpportunity @relation(fields: [opportunityId], references: [id])
  replyDraft  GrowthReplyDraft  @relation(fields: [replyDraftId], references: [id])
  registeredBy User             @relation("GrowthInterventionRegisteredBy", fields: [registeredById], references: [id])
  metrics     GrowthInterventionMetric[]

  @@index([workspaceId, publishedAt])
  @@index([opportunityId])
  @@map("growth_interventions")
}

model GrowthInterventionMetric {
  id              String             @id @default(uuid())
  workspaceId     String             @map("workspace_id")
  interventionId  String             @map("intervention_id")
  kind            GrowthMetricKind
  value           Float?
  valueKnown      Boolean            @default(false) @map("value_known")
  source          GrowthMetricSource
  capturedAt      DateTime           @map("captured_at")
  notes           String?            @db.Text
  provenance      String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  workspace    Workspace          @relation(fields: [workspaceId], references: [id])
  intervention GrowthIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, capturedAt])
  @@index([interventionId])
  @@map("growth_intervention_metrics")
}

model GrowthTopicInsight {
  id          String                   @id @default(uuid())
  workspaceId String                   @map("workspace_id")
  pieceId     String?                  @map("piece_id")
  runId       String?                  @map("run_id")
  topicKey    String                   @map("topic_key")
  summary     Json
  status      GrowthTopicInsightStatus @default(draft_for_discovery)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  workspace Workspace              @relation(fields: [workspaceId], references: [id])
  piece     ContentPiece?          @relation(fields: [pieceId], references: [id])
  run       GrowthConversationRun? @relation(fields: [runId], references: [id])

  @@index([workspaceId, status, createdAt])
  @@index([topicKey])
  @@map("growth_topic_insights")
}
